PG_CONNECTION_STRING=postgresql://sok_tutor:sok_tutor@localhost:5017/sok_tutor
VITE_AI_PROVIDER= # defaults to openai in node env prod, ollama-local in local dev 
OPENAI_API_KEY= # only needed for openai ai provider
DATA_EXPORT_KEY= # "password"/"key" to export data
VITE_NON_STUDY_MODE_HOSTNAME= # hostname under which the 'non-study' mode is used (for local dev, you can use a localhost subdomain, e.g., demo.localhost)
BETTER_AUTH_SECRET= # secret generated with openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000 # canonical domain
BETTER_AUTH_ALLOWED_HOSTS="localhost:3000" # optional comma separated list of hosts
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=