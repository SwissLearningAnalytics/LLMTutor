{
  "name": "swiss-learning-analytics-llm-tutor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MPL-2.0",
  "scripts": {
    "dev": "VITE_APP_VERSION=$(git describe --tags) vite dev --mode dev-local",
    "build": "VITE_APP_VERSION=$(git describe --tags) vite build --mode dev-local",
    "lint": "biome check",
    "build:dev": "VITE_APP_VERSION=$(git describe --tags) vite build --mode dev",
    "build:prod": "VITE_APP_VERSION=$(git describe --tags) vite build --mode prod",
    "format": "prettier ./src --write",
    "lint:fix": "biome check --fix",
    "lint:fix:unsafe": "biome check --fix --unsafe",
    "db:up": "docker compose -f docker-compose/stack.yml up -d",
    "db:down": "docker compose -f docker-compose/stack.yml down",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "db:migrations:generate": "drizzle-kit generate",
    "db:migrations:apply": "drizzle-kit migrate",
    "generate:tutors-index": "tsx generate-tutors-index.ts",
    "prepare": "pnpm generate:tutors-index",
    "auth:generate": "pnpm dlx auth generate --output src/lib/auth-schema.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.122",
    "@ai-sdk/react": "4.0.184",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@tanstack/react-devtools": "0.10.15",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "5.108.3",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.7",
    "ai": "7.0.179",
    "better-auth": "^1.7.27",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "drizzle-orm": "0.45.4",
    "katex": "^0.19.1",
    "lucide-react": "1.78.0",
    "marked": "^18.2.1",
    "motion": "14.14.0",
    "nanoid": "6.0.2",
    "ollama-ai-provider-v2": "4.1.0",
    "pg": "8.23.1",
    "qrcode.react": "4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "slugify": "^1.6.9",
    "srvx": "1.0.8",
    "tailwind-merge": "3.7.1",
    "tw-animate-css": "1.4.0",
    "yaml": "2.9.1",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@modyfi/vite-plugin-yaml": "1.1.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/devtools-vite": "0.8.7",
    "@tanstack/react-query-devtools": "5.108.3",
    "@tanstack/react-router-devtools": "1.167.4",
    "@tanstack/router-plugin": "1.169.0",
    "@types/node": "25.6.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "dotenv": "18.0.10",
    "drizzle-kit": "0.31.11",
    "nitro": "3.0.261103-rc",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-svgr": "5.2.0"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-tailwindcss"
    ],
    "tailwindStylesheet": "./src/styles/app.css",
    "tailwindFunctions": [
      "cva",
      "cn"
    ]
  }
}
