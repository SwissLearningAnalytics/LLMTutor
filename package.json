{
  "name": "swiss-learning-analytics-llm-tutor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MPL-2.0",
  "scripts": {
    "dev": "VITE_APP_VERSION=$(git describe --tags) vite dev --mode dev-local",
    "build": "VITE_APP_VERSION=$(git describe --tags) vite build --mode dev-local",
    "lint": "biome check",
    "build:dev": "VITE_APP_VERSION=$(git describe --tags) vite build --mode dev",
    "build:prod": "VITE_APP_VERSION=$(git describe --tags) vite build --mode prod",
    "format": "prettier ./src --write",
    "lint:fix": "biome check --fix",
    "lint:fix:unsafe": "biome check --fix --unsafe",
    "db:up": "docker compose -f docker-compose/stack.yml up -d",
    "db:down": "docker compose -f docker-compose/stack.yml down",
    "db:studio": "npx drizzle-kit studio",
    "db:push": "npx drizzle-kit push",
    "db:migrations:generate": "npx drizzle-kit generate",
    "db:migrations:apply": "npx drizzle-kit migrate",
    "generate:tutors-index": "tsx generate-tutors-index.ts",
    "prepare": "pnpm generate:tutors-index"
  },
  "dependencies": {
    "@ai-sdk/openai": "3.0.61",
    "@ai-sdk/react": "3.0.177",
    "@fontsource-variable/hanken-grotesk": "^5.2.8",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "1.2.4",
    "@tanstack/react-devtools": "0.10.2",
    "@tanstack/react-form": "^1.33.0",
    "@tanstack/react-query": "5.100.9",
    "@tanstack/react-router": "1.169.2",
    "@tanstack/react-router-ssr-query": "1.166.12",
    "@tanstack/react-start": "1.167.64",
    "ai": "6.0.175",
    "better-auth": "^1.6.23",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "katex": "^0.16.45",
    "lucide-react": "1.14.0",
    "marked": "^18.0.3",
    "motion": "12.38.0",
    "nanoid": "5.1.11",
    "ollama-ai-provider-v2": "3.5.0",
    "pg": "8.20.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "slugify": "^1.6.9",
    "srvx": "0.11.15",
    "tailwind-merge": "3.5.0",
    "tw-animate-css": "1.4.0",
    "yaml": "2.8.4",
    "zod": "4.4.3",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@modyfi/vite-plugin-yaml": "1.1.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/devtools-vite": "0.6.0",
    "@tanstack/react-query-devtools": "5.100.9",
    "@tanstack/react-router-devtools": "1.166.13",
    "@tanstack/router-plugin": "1.167.34",
    "@types/node": "25.6.0",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "nitro": "3.0.260429-beta",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "0.8.0",
    "tailwindcss": "4.2.4",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vite": "^8.0.10",
    "vite-plugin-svgr": "5.2.0"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-tailwindcss"
    ],
    "tailwindStylesheet": "./src/styles/app.css",
    "tailwindFunctions": [
      "cva",
      "cn"
    ]
  }
}
